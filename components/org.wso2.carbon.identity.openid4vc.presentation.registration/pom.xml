<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.wso2.carbon.identity.openid4vc</groupId>
        <artifactId>identity-openid4vc</artifactId>
        <version>1.1.7-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>org.wso2.carbon.identity.openid4vc.presentation.registration</artifactId>
    <packaging>bundle</packaging>
    <name>WSO2 Carbon - OpenID4VP Presentation Self-Registration</name>
    <description>Wallet-based self-registration executor for the IS flow execution engine</description>

    <dependencies>
        <!-- OpenID4VP Common module -->
        <dependency>
            <groupId>org.wso2.carbon.identity.openid4vc</groupId>
            <artifactId>org.wso2.carbon.identity.openid4vc.presentation.common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- OpenID4VP Server module (models, exceptions, service interfaces, data holder) -->
        <dependency>
            <groupId>org.wso2.carbon.identity.openid4vc</groupId>
            <artifactId>org.wso2.carbon.identity.openid4vc.presentation.server</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- OpenID4VP Verification module -->
        <dependency>
            <groupId>org.wso2.carbon.identity.openid4vc</groupId>
            <artifactId>org.wso2.carbon.identity.openid4vc.presentation.verification</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- WSO2 Identity Framework -->
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.authentication.framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.application.common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.flow.execution.engine</artifactId>
        </dependency>
        <dependency>
            <groupId>org.wso2.carbon.identity.framework</groupId>
            <artifactId>org.wso2.carbon.identity.core</artifactId>
        </dependency>

        <!-- OSGi -->
        <dependency>
            <groupId>org.eclipse.platform</groupId>
            <artifactId>org.eclipse.osgi.services</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <version>${osgi.service.component.annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Apache Commons -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <failOnError>false</failOnError>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <version>5.1.2</version>
                <extensions>true</extensions>
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>${project.artifactId}</Bundle-Name>
                        <Bundle-RequiredExecutionEnvironment>JavaSE-11</Bundle-RequiredExecutionEnvironment>
                        <Export-Package>
                            !org.wso2.carbon.identity.openid4vc.presentation.registration.internal,
                            org.wso2.carbon.identity.openid4vc.presentation.registration.*;version="${identity.oid4vc.pkg.version}"
                        </Export-Package>
                        <Private-Package>
                            org.wso2.carbon.identity.openid4vc.presentation.registration.internal
                        </Private-Package>
                        <Import-Package>
                            org.wso2.carbon.identity.openid4vc.presentation.common.*;version="${identity.oid4vc.pkg.version}",
                            org.wso2.carbon.identity.openid4vc.presentation.server.*;version="${identity.oid4vc.pkg.version}",
                            org.wso2.carbon.identity.openid4vc.presentation.verification.*;version="${identity.oid4vc.pkg.version}",
                            org.wso2.carbon.identity.flow.execution.engine;version="${identity.framework.package.import.version.range}",
                            org.wso2.carbon.identity.flow.execution.engine.exception;version="${identity.framework.package.import.version.range}",
                            org.wso2.carbon.identity.flow.execution.engine.graph;version="${identity.framework.package.import.version.range}",
                            org.wso2.carbon.identity.flow.execution.engine.model;version="${identity.framework.package.import.version.range}",
                            org.osgi.service.component; version="[1.2.0, 2.0.0)",
                            *;resolution:=optional
                        </Import-Package>
                        <DynamicImport-Package>*</DynamicImport-Package>
                        <_dsannotations-options>version;minimum=1.2.0</_dsannotations-options>
                        <_dsannotations>*</_dsannotations>
                        <_removeheaders>Require-Capability</_removeheaders>
                        <Provide-Capability>
                            osgi.service;objectClass:List&lt;String&gt;="org.wso2.carbon.identity.flow.execution.engine.graph.Executor"
                        </Provide-Capability>
                    </instructions>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <osgi.service.component.annotations.version>1.3.0</osgi.service.component.annotations.version>
    </properties>
</project>
